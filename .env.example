# Environment variables
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=info@afronyankatours.com
ADMIN_EMAIL=admin@afro-nyanka-tours.com

# Admin portal
# Comma-separated; each new email gets an account + a set-password link on startup.
# Removing an email deactivates that admin on next startup. Leaving it empty changes nothing.
ADMIN_EMAILS=owner@example.com
# Base URL of the frontend; set-password links go to {FRONTEND_URL}/admin/set-password?token=...
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed CORS origins (default * allows any)
CORS_ORIGINS=*
# Shared secret the weekly-summary cron job sends as X-Cron-Secret
CRON_SECRET=change-me

# Database
DATABASE_URL=postgresql://afro_user:afro_password@localhost:5432/afro_tours_db

# Development settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
